<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast checks that don't need the game: the rules that decide what a player may send, what a received file is turned into,
    and how images are cut and resized. Run them with `dotnet test` before pushing.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomContentCore\CustomContentCore.csproj" />
    <!-- copied next to the tests: the image code uses the game's colour type -->
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" Private="False" />
  </ItemGroup>

  <!-- the game's own references aren't copied next to a build, but the tests have to load this one to run -->
  <Target Name="CopyGameAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(GamePath)/MonoGame.Framework.dll;$(GamePath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
