<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast checks that don't need the game: the rules that decide what a player may send, what a received file is turned into,
    and how images are cut and resized. Run them with `dotnet test` before pushing.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <!-- building the mods for the tests must not copy them into the game's Mods folder: the game may be running -->
  <ItemGroup>
    <ProjectReference Include="..\CustomContentCore\CustomContentCore.csproj" AdditionalProperties="EnableModDeploy=false" />
    <!-- only its pure data helpers are tested (FishData), which touch nothing from the game -->
    <ProjectReference Include="..\CustomFish\CustomFish.csproj" AdditionalProperties="EnableModDeploy=false" />
    <!-- same again (MiningData): what counts as a gem, mineral or artefact, and the odds of finding one -->
    <ProjectReference Include="..\CustomMining\CustomMining.csproj" AdditionalProperties="EnableModDeploy=false" />
    <!-- copied next to the tests: the image code uses the game's colour type -->
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" Private="False" />
    <Reference Include="SkiaSharp" HintPath="$(GamePath)/SkiaSharp.dll" Private="False" />
  </ItemGroup>

  <!-- the game's own references aren't copied next to a build, but the tests have to load this one to run -->
  <Target Name="CopyGameAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(GamePath)/MonoGame.Framework.dll;$(GamePath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll;$(GamePath)/SkiaSharp.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- SkiaSharp's native library, for the JPEG checks (on Linux it sits in the game folder) -->
    <Copy SourceFiles="$(GamePath)/libSkiaSharp.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(GamePath)/libSkiaSharp.so')" />
  </Target>

</Project>
